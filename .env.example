# Copy to .env.local. Never commit .env.local.
# Supabase > Connect or Project Settings > API Keys. The publishable key is intended for the browser;
# database RLS and transaction RPCs enforce permissions.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server only. Required for administrator-created teacher accounts. A legacy
# SUPABASE_SERVICE_ROLE_KEY is also accepted while migrating existing deployments.
# NEVER prefix this with NEXT_PUBLIC_ or expose it in browser code.
SUPABASE_SECRET_KEY=your-supabase-secret-key
